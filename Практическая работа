3.Количество цифр в числе 
n = int(input("Введите натуральное число: "))
count = 0

if n == 0:
    count = 1
else:
    while n > 0:
        count += 1
        n //= 10

print(f"Количество цифр: {count}")
4. Сумма цифр числа 

n = int(input("Введите натуральное число: "))
digits_sum = 0

while n > 0:
    last_digit = n % 10
    digits_sum += last_digit
    n //= 10

print(f"Сумма цифр: {digits_sum}")


5. Переворот числа 

n = int(input("Введите натуральное число: "))
reversed_num = 0

while n > 0:
    last_digit = n % 10
    reversed_num = reversed_num * 10 + last_digit
    n //= 10

print(f"Число в обратном порядке: {reversed_num}")


