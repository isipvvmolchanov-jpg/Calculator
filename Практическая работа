8. Наибольший общий делитель 

a = int(input("Введите первое число: "))
b = int(input("Введите второе число: "))

while a != 0 and b != 0:
    if a > b:
        a %= b
    else:
        b %= a

nod = a + b  
print(f"Наибольший общий делитель: {nod}")

9. Поиск числа Фибоначчи до n 
n = int(input("Введите ограничение n: "))
a, b = 0, 1

while a <= n:
    print(a, end=" ")
    a, b = b, a + b

10. Игра угадай число 
import random

# Загадываем число от 1 до 100
secret_number = random.randint(1, 100)
attempts = 0

print("Я загадал число от 1 до 100. Попробуй угадать!")

while True:
    user_guess = int(input("Ваш вариант: "))
    attempts += 1
    
    if user_guess < secret_number:
        print("Больше!")
    elif user_guess > secret_number:
        print("Меньше!")
    else:
        print(f"Поздравляю! Вы угадали число за {attempts} попыток.")
        break
